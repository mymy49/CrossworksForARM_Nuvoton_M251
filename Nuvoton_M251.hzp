<!DOCTYPE CrossStudio_Project_File>
<solution Name="Nuvoton_M251" target="8" version="2">
  <project Name="Nuvoton_M251">
    <configuration
      Name="Common"
      combine_command="$(StudioDir)/bin/mkpkg -exclude ./Convert.sh -exclude ./Extract.sh -exclude ./Nuvoton_M251.hzp -exclude ./Nuvoton_M251.hzs -exclude ./Nuvoton_M251.hzq -exclude ./readme.md -exclude ./examples -exclude ./images -exclude ./.gitignore -c &quot;$(CombiningOutputFilePath)&quot; ."
      combine_output_filepath="$(ProjectDir)/Nuvoton_M251.hzq"
      project_directory=""
      project_type="Combining" />
    <folder
      Name="packages"
      exclude=""
      filter=""
      path="packages"
      recurse="Yes" />
    <folder
      Name="targets"
      exclude=""
      filter=""
      path="targets"
      recurse="Yes" />
  </project>
</solution>
